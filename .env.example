# Copy this file to .env.local and fill in what you have.
# Anything you leave blank is hidden on the website and on invoices.
# Never put made-up phone numbers, emails or bank details here.

# --- The business (shown on the public site and on invoices) ---
BUSINESS_NAME=Swan Street Lock-Ups
# Correspondence address for invoices. Leave blank if you do not want it printed yet.
BUSINESS_ADDRESS=
# Contact email. Leave blank until your domain mailbox is ready.
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Set to true only if you are VAT registered. Leave VAT_NUMBER blank if you do not want it printed.
VAT_REGISTERED=false
VAT_NUMBER=

# Bank details for BACS, printed on invoices only when both are set.
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=

# Public web address, used in emails and the 2FA app label. Change when you have a domain.
SITE_URL=http://127.0.0.1:43141

# --- The two owners (email + password). Change these before going live. ---
ADMIN1_EMAIL=father@localhost
ADMIN1_PASSWORD=change-me-father
# Optional. If set, two-factor is already switched on for this owner.
# Leave blank to scan a QR code on first login instead.
ADMIN1_TOTP_SECRET=

ADMIN2_EMAIL=son@localhost
ADMIN2_PASSWORD=change-me-son
ADMIN2_TOTP_SECRET=

# At least 32 random characters. Used to sign the owners' login cookie.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional. Lets a host's scheduler call /api/jobs/monthly and /api/jobs/reminders.
CRON_SECRET=replace-with-another-long-random-string

# How many days after the invoice date payment is due (printed on the PDF).
INVOICE_DUE_DAYS=14

# --- Email, using the mailbox that comes with your domain (free with most hosts) ---
# Leave blank until the mailbox is ready. Invoices and PDFs still work without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# true if your host needs a secure connection on port 465
SMTP_SECURE=false

# SQLite file. Default is fine.
DATABASE_PATH=./data/swan-street.db
