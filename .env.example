# Copy this file to .env.local on your computer (or set the same names
# on your host). Leave blank what you do not use. Never commit the filled file.

# Login for Jack’s owners’ desk
JACK_USERNAME=
JACK_PASSWORD=

# Login for David’s owners’ desk
DAVID_USERNAME=
DAVID_PASSWORD=

# Random long string used to keep you signed in (any 32+ character secret)
SESSION_SECRET=

# Secret for the monthly invoice web address (a long random string)
CRON_SECRET=

# Optional: outgoing email connection. Leave blank to still make PDFs without sending.
# Invoice From addresses are set per landlord on the Garages page, not here.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional: full path to the SQLite file. Default is data/swan.sqlite
DATABASE_PATH=
